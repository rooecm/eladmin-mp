<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>rooe-admin</artifactId>
        <groupId>fun.rooe</groupId>
        <version>1.1</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>rooe-admin-system</artifactId>
    <name>核心模块</name>

    <properties>
        <!-- oshi监控需要指定jna版本, 问题详见 https://github.com/oshi/oshi/issues/1040 -->
        <jna.version>5.8.0</jna.version>
    </properties>

    <dependencies>
        <!-- 框架基础设施 -->
        <dependency>
            <groupId>fun.rooe</groupId>
            <artifactId>rooe-admin-framework</artifactId>
            <version>1.1</version>
        </dependency>

        <!-- 代码生成模块 -->
        <dependency>
            <groupId>fun.rooe</groupId>
            <artifactId>rooe-admin-generator</artifactId>
            <version>1.1</version>
            <exclusions>
                <exclusion>
                    <groupId>fun.rooe</groupId>
                    <artifactId>rooe-admin-common</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- tools 模块包含了 common 和 logging 模块 -->
        <dependency>
            <groupId>fun.rooe</groupId>
            <artifactId>rooe-admin-tools</artifactId>
            <version>1.1</version>
        </dependency>

        <!-- 获取系统信息 -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
            <version>6.6.5</version>
        </dependency>
    </dependencies>

    <!-- 打包 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
