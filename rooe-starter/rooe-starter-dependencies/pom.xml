<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- No Boot parent: importing this BOM must not change the application's Boot baseline. -->
    <groupId>fun.rooe</groupId>
    <artifactId>rooe-starter-dependencies</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>rooe-starter-dependencies</name>

    <properties>
        <logbook.version>3.12.3</logbook.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>fun.rooe</groupId>
                <artifactId>rooe-starter-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fun.rooe</groupId>
                <artifactId>rooe-observability-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.zalando</groupId>
                <artifactId>logbook-bom</artifactId>
                <version>${logbook.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
